# The Lounge List - Configuration Environment Variables
# Copiez ce fichier en .env et remplissez avec vos valeurs réelles

# ============================================
# APPLICATION GÉNÉRALE
# ============================================

APP_NAME="The Lounge List"
APP_TAGLINE="A competitive Geometry Dash ranking platform."
APP_TIMEZONE="UTC"  # Ex: Europe/Paris, America/New_York, etc.
DEFAULT_LANGUAGE="fr"  # Code langue par défaut (voir lang/*.php)

# ============================================
# BASE DE DONNÉES MySQL/MariaDB
# ============================================

DB_HOST=localhost          # Adresse du serveur MySQL (localhost pour homelab)
DB_PORT=3306              # Port MySQL (défaut: 3306)
DB_NAME=the_lounge_list   # Nom de la base de données à créer
DB_USER=root              # Utilisateur MySQL
DB_PASSWORD=votre_mot_de_passe_mysql  # Mot de passe MySQL

# ============================================
# COMPTE ADMINISTRATEUR (Owner)
# ============================================

OWNER_USERNAME=admin      # Nom d'utilisateur admin initial
OWNER_EMAIL=admin@exemple.com  # E-mail du propriétaire (optionnel mais recommandé)
OWNER_PASSWORD=votre_mot_de_passe_admin  # Mot de passe admin (min. 8 caractères)

# ============================================
# E-MAIL / SMTP - Vérification des comptes 📧
# ============================================

EMAIL_ENABLED=true        # true = activer vérification par e-mail, false = désactivé
SMTP_HOST=smtp.gmail.com  # Ex: smtp.gmail.com, smtp.office365.com, mail.votre-domaine.local
SMTP_PORT=587             # 587 pour TLS ou 465 pour SSL
SMTP_ENCRYPTION=tls       # tls | ssl | none (dépend de votre fournisseur SMTP)
SMTP_USERNAME=votre@email.com    # Adresse e-mail pour l'envoi
SMTP_PASSWORD=mot_de_passe_smtp      # Mot de passe SMTP ou "App Password"

FROM_ADDRESS=noreply@votre-domaine.com  # E-mail d'expéditeur (ex: noreply@...)
FROM_NAME="The Lounge List"    # Nom affiché sur les e-mails

# ============================================
# DISCORD - Notifications optionnelles 🎮
# ============================================

DISCORD_WEBHOOK_URL=""            # URL du webhook Discord (optionnel)
DISCORD_BOT_TOKEN=""              # Token du bot Discord (optionnel, pour DM)
DISCORD_SERVER_WIDGET_URL=""      # Widget du serveur Discord (optionnel)
DISCORD_SERVER_ID=""              # ID du serveur (utilisé si widget_url est vide)
DISCORD_SERVER_THEME=dark         # dark | light

# ============================================
# reCAPTCHA v2 - Protection anti-spam 🔒
# ============================================

RECAPTCHA_SITE_KEY=""             # Clé site reCAPTCHA (optionnel, vide = désactivé)
RECAPTCHA_SECRET_KEY=""           # Clé secrète reCAPTCHA (optionnel)

# Pour obtenir ces clés :
# 1. Allez sur https://www.google.com/recaptcha/admin
# 2. Créez un nouveau site
# 3. Choisissez "reCAPTCHA v2" -> "I'm not a robot"
# 4. Collez les codes dans vos formulaires HTML

# IMPORTANT : Si vous videz RECAPTCHA_SITE_KEY, reCAPTCHA sera désactivé automatiquement !

# ============================================
# SÉCURITÉ
# ============================================

TRUST_PROXY=false             # true seulement si derrière un proxy de confiance
SESSION_COOKIE_SECURE=true    # true pour HTTPS uniquement (homelab sans SSL: false)
DEBUG_MODE=false              # true pour afficher les erreurs PHP en développement

# ============================================
# URL DU SITE
# ============================================

BASE_URL=/the-lounge-list     # Chemin relatif (ex: /demonlist, /the-lounge-list)
PUBLIC_URL=""                 # URL complète optionnelle (ex: https://votre-domaine.com/the-lounge-list)

# ============================================
# MISE À JOUR AUTOMATIQUE
# ============================================

GITHUB_REPOSITORY=https://github.com/votre-username/The-Lounge-List  # Votre repo GitHub
UPDATE_REF=main               # Branche à surveiller pour les mises à jour
